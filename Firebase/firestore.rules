rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/saves/{slotId} {
      function isOwner() {
        return request.auth != null
          && request.auth.uid == uid
          && slotId == '0';
      }

      function validBackup() {
        let data = request.resource.data;

        return data.keys().hasAll([
            'backupFormatVersion', 'saveVersion', 'saveJson'
          ])
          && data.keys().hasOnly([
            'backupFormatVersion', 'saveVersion', 'saveJson'
          ])
          && data.backupFormatVersion is int
          && data.backupFormatVersion == 1
          && data.saveVersion is int
          && data.saveVersion > 0
          && data.saveJson is string
          && data.saveJson.toUtf8().size() > 0
          && data.saveJson.toUtf8().size() <= 524288;
      }

      function canReplaceBackup() {
        return request.resource.data.saveVersion
            >= resource.data.get('saveVersion', 0)
          && request.resource.data.backupFormatVersion
            >= resource.data.get('backupFormatVersion', 0);
      }

      allow get: if isOwner();
      allow create: if isOwner() && validBackup();
      allow update: if isOwner()
        && validBackup()
        && canReplaceBackup();
    }
  }
}
