  _feature: "\uC9D0\uC2B9\uC758 \uB450\uAC1C\uACE8\uC744 \uB2EE\uC740 \uC5BC\uAD74\uACFC
    \uAC70\uB300\uD55C \uBC1C\uD1B1\uC774 \uC704\uC555\uAC10\uC744 \uC790\uC544\uB0B4\uC9C0\uB9CC,
    \uC6C0\uC9C1\uC784\uC740 \uC758\uC678\uB85C \uB290\uB9BF\uD558\uB2E4. \uD3C9\uC18C\uC5D0\uB294
    \uBB35\uBB35\uD788 \uC804\uC9C4\uD558\uB2E4\uAC00 \uCCB4\uB825\uC774 \uC904\uC5B4\uB4E4\uBA74
    \uC8FC\uBCC0\uC744 \uD55C\uAEBC\uBC88\uC5D0 \uC704\uD611\uD558\uB294 \uAC15\uB825\uD55C
    \uACF5\uACA9\uC744 \uD3BC\uCE5C\uB2E4."
  _attackDescription: "\uAC00\uAE4C\uC774 \uB2E4\uAC00\uC628 \uC0C1\uB300\uC5D0\uAC8C
    \uADFC\uC811 \uACF5\uACA9\uC744 \uAC00\uD55C\uB2E4. \uCCB4\uB825\uC774 \uC808\uBC18
    \uC774\uD558\uB85C \uB5A8\uC5B4\uC9C0\uBA74 \uBC14\uB2E5\uC5D0 \uC6D0\uD615\uC758
    \uACBD\uACE0\uAC00 \uB5A0\uC624\uB978 \uB4A4, \uB2E8 \uD55C \uCC28\uB840 \uB113\uC740
    \uBC94\uC704\uB97C \uB0B4\uB824\uCC0D\uB294\uB2E4."
  _backgroundStory: "\uC9D0\uC2B9\uC758 \uB450\uAC1C\uACE8\uC744 \uB2EE\uC740 \uC5BC\uAD74
    \uB54C\uBB38\uC5D0 \uBBF8\uB178\uD1A0\uC2A4\uB97C \uBD88\uAE38\uD55C \uC874\uC7AC\uB85C
    \uC5EC\uAE30\uB294 \uC774\uB4E4\uB3C4 \uC788\uB2E4. \uADF8\uB7EC\uB098 \uADF8\uB7F0
    \uC778\uC0C1\uC774 \uC2E4\uC81C \uC815\uCCB4\uC640 \uAD00\uB828\uC774 \uC788\uB294\uC9C0\uB294
    \uC54C\uB824\uC9C0\uC9C0 \uC54A\uC558\uB2E4. \uD655\uC2E4\uD55C \uAC83\uC740
    \uC774 \uAD34\uBB3C\uC774 \uC131\uCC44\uC5D0 \uC2EC\uAC01\uD55C \uC704\uD611\uC774
    \uB41C\uB2E4\uB294 \uC0AC\uC2E4\uBFD0\uC774\uB2E4."
  _rewardAmount: 200
