  _representativeImage: {fileID: 0}
  _feature: "\uAE08\uBE5B \uB0A0\uAC1C\uB97C \uD3BC\uCE58\uACE0 \uB0A0\uC544\uB2E4\uB2C8\uB294
    \uBAA8\uC2B5\uC740 \uC5EC\uB290 \uB098\uBE44\uC640 \uB2E4\uB974\uC9C0 \uC54A\uC9C0\uB9CC,
    \uC9C0\uC0C1\uC758 \uD568\uC815\uC5D0\uB294 \uC544\uB791\uACF3\uD558\uC9C0 \uC54A\uB294\uB2E4.
    \uB204\uAD70\uAC00 \uAC00\uAE4C\uC774 \uB2E4\uAC00\uC640\uB3C4 \uB9DE\uC11C \uC2F8\uC6B0\uC9C0
