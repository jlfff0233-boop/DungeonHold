  _attackDescription: "\uD50C\uB808\uC774\uC5B4\uAC00 \uAC00\uAE4C\uC774 \uC811\uADFC\uD558\uB354\uB77C\uB3C4
    \uACF5\uACA9\uD558\uAC70\uB098 \uBC18\uACA9\uD558\uC9C0 \uC54A\uB294\uB2E4. \uC8FC\uBCC0\uC758
    \uC801\uC5D0\uAC8C \uAD00\uC2EC\uC744 \uB450\uC9C0 \uC54A\uACE0 \uC815\uD574\uC9C4
    \uBAA9\uC801\uC9C0\uB97C \uD5A5\uD574 \uB0A0\uC544\uAC04\uB2E4."
  _backgroundStory: "\uD654\uB824\uD558\uACE0 \uC628\uC21C\uD574 \uBCF4\uC774\uB294
    \uBAA8\uC2B5 \uD0D3\uC5D0 \uBAAC\uC2A4\uD130\uB77C\uACE0\uB294 \uC0DD\uAC01\uD558\uAE30
    \uC5B4\uB824\uC6B4 \uC874\uC7AC\uB2E4. \uADF8\uB7EC\uB098 \uC131\uCC44\uC758
    \uBC29\uC5B4\uC790\uB4E4\uC5D0\uAC8C\uB294 \uC9C1\uC811 \uC2F8\uC6B0\uC9C0 \uC54A\uB294
